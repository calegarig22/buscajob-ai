# Postgres (Neon ou qualquer Postgres compatível)
DATABASE_URL=postgresql://usuario:senha@host-exemplo/neondb?sslmode=require

# Google Gemini (opcional: sem chave, o app usa leitura e cartas locais, sem IA)
GEMINI_API_KEY=
# opcional, padrão gemini-3.6-flash
GEMINI_MODEL=
# opcional: "on" reavalia as melhores vagas com o Gemini (exige plano pago)
AI_SCORING=

# Segredos (gere com: openssl rand -hex 32)
AUTH_SECRET=
CRON_SECRET=

# Fontes de vagas opcionais
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
SERPAPI_KEY=

# Só para scripts/migrate-multiuser.mjs (cria o admin inicial)
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
